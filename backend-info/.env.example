# MongoDB (docker-compose pisa este valor con el de la red interna)
MONGODB_URL=mongodb://admin:change_me@localhost:27017/contratos_db?authSource=admin

# Supabase (validacion de los tokens de login)
SUPABASE_URL=https://your-project.supabase.co

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your_account
AZURE_STORAGE_ACCOUNT_KEY=your_account_key
AZURE_STORAGE_CONTAINER_NAME=contratos

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/contract-analysis
N8N_WEBHOOK_SECRET=change_me

# App
APP_ENV=development
