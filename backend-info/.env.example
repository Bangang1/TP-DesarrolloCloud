# MongoDB
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/contratos_db

# Supabase (verificación JWT)
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase

# Azure Blob Storage (mismos valores que el frontend)
AZURE_STORAGE_ACCOUNT_NAME=tu-cuenta
AZURE_STORAGE_ACCOUNT_KEY=...
AZURE_STORAGE_CONTAINER_NAME=contratos

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/analizar-contrato
N8N_WEBHOOK_SECRET=your_n8n_secret

# OpenAI
OPENAI_API_KEY=sk-...

# App
APP_ENV=development
APP_SECRET_KEY=your_super_secret_key
