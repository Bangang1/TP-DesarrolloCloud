# Variables que lee docker-compose.yml (copiar a .env)
# Las del frontend van en frontend/.env y las del backend en backend-info/.env

# Credenciales root de MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me

# Modelo de Claude: lo usan el workflow de n8n (analisis) y el backend (chat).
# La clave se crea en https://platform.claude.com (API keys).
#   claude-haiku-5-5  -> el mas economico (recomendado para empezar)
#   claude-sonnet-5-5 -> mas preciso, unas 20 veces mas caro
CLAUDE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Secreto compartido backend <-> n8n (mismo valor en backend-info/.env)
N8N_WEBHOOK_SECRET=change_me
