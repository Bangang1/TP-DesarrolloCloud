# Variables que docker-compose lee desde la raíz del proyecto.
# Las del backend van en backend-info/.env (ver backend-info/.env.example)
# y las del frontend en frontend/.env.local (ver frontend/.env.local.example).

# Secreto compartido backend <-> n8n (mismo valor que en backend-info/.env)
N8N_WEBHOOK_SECRET=your_n8n_secret
