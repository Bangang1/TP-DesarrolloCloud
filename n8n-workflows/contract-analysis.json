{
  "name": "Contract Analysis Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analizar-contrato",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Recibir Contrato",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "analizar-contrato"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.secret }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        }
      },
      "id": "validate-secret",
      "name": "Validar Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.body.contrato_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-from-azure",
      "name": "Descargar PDF de Azure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "extract-pdf-text",
      "name": "Extraer Texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        790,
        200
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Eres un experto en analisis de contratos legales. Analiza el siguiente contrato y extrae la informacion en formato JSON con esta estructura exacta:\n\n{\n  \"summary\": \"Resumen ejecutivo del contrato en 2-3 parrafos\",\n  \"parties\": [\"Nombre Parte 1\", \"Nombre Parte 2\"],\n  \"key_dates\": [\n    {\"type\": \"inicio\", \"date\": \"YYYY-MM-DD\", \"description\": \"...\"}\n  ],\n  \"risks\": [\n    {\"clause\": \"Clausula X\", \"description\": \"Descripcion del riesgo\", \"severity\": \"low|medium|high\"}\n  ],\n  \"clauses\": [\n    {\"title\": \"Titulo clausula\", \"content\": \"Contenido relevante\"}\n  ]\n}\n\nResponde SOLO con el JSON, sin texto adicional."
            },
            {
              "role": "user",
              "content": "=Analiza este contrato:\n\n{{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "analyze-with-gpt",
      "name": "Analizar con GPT-4o-mini",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        1010,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend-info:8000/webhooks/n8n/analysis-complete",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "contract_id",
              "value": "={{ $('Webhook - Recibir Contrato').item.json.body.contrato_id }}"
            },
            {
              "name": "user_id",
              "value": "={{ $('Webhook - Recibir Contrato').item.json.body.usuario_id }}"
            },
            {
              "name": "status",
              "value": "completado"
            },
            {
              "name": "summary",
              "value": "={{ JSON.parse($json.message.content).summary }}"
            },
            {
              "name": "parties",
              "value": "={{ JSON.parse($json.message.content).parties }}"
            },
            {
              "name": "key_dates",
              "value": "={{ JSON.parse($json.message.content).key_dates }}"
            },
            {
              "name": "risks",
              "value": "={{ JSON.parse($json.message.content).risks }}"
            },
            {
              "name": "clauses",
              "value": "={{ JSON.parse($json.message.content).clauses }}"
            },
            {
              "name": "raw_text",
              "value": "={{ $('Extraer Texto PDF').item.json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-backend",
      "name": "Notificar Backend - Exito",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1230,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend-info:8000/webhooks/n8n/analysis-complete",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "contract_id",
              "value": "={{ $('Webhook - Recibir Contrato').item.json.body.contrato_id }}"
            },
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "error_message",
              "value": "Secret invalido"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-backend-error",
      "name": "Notificar Backend - Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"received\": true }"
      },
      "id": "respond-webhook",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        500
      ]
    }
  ],
  "connections": {
    "Webhook - Recibir Contrato": {
      "main": [
        [
          {
            "node": "Validar Secret",
            "type": "main",
            "index": 0
          },
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Secret": {
      "main": [
        [
          {
            "node": "Descargar PDF de Azure",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Backend - Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar PDF de Azure": {
      "main": [
        [
          {
            "node": "Extraer Texto PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer Texto PDF": {
      "main": [
        [
          {
            "node": "Analizar con GPT-4o-mini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analizar con GPT-4o-mini": {
      "main": [
        [
          {
            "node": "Notificar Backend - Exito",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}