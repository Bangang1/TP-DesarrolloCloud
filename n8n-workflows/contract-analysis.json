{
  "id": "analizarContrato",
  "name": "Contract Analysis Pipeline",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analizar-contrato",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Recibir Contrato",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "analizar-contrato"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.secret }}",
              "value2": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        }
      },
      "id": "validate-secret",
      "name": "Validar Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.body.contrato_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-from-azure",
      "name": "Descargar PDF de Azure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "extract-pdf-text",
      "name": "Extraer Texto PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        790,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0.2, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: \"Eres un experto en analisis de contratos legales. Analiza el siguiente contrato y extrae la informacion en formato JSON con esta estructura exacta:\\n\\n{\\n  \\\"summary\\\": \\\"Resumen ejecutivo del contrato en 2-3 parrafos\\\",\\n  \\\"parties\\\": [\\\"Nombre Parte 1\\\", \\\"Nombre Parte 2\\\"],\\n  \\\"key_dates\\\": [\\n    {\\\"type\\\": \\\"inicio\\\", \\\"date\\\": \\\"YYYY-MM-DD\\\", \\\"description\\\": \\\"...\\\"}\\n  ],\\n  \\\"risks\\\": [\\n    {\\\"clause\\\": \\\"Clausula X\\\", \\\"description\\\": \\\"Descripcion del riesgo\\\", \\\"severity\\\": \\\"low|medium|high\\\"}\\n  ],\\n  \\\"clauses\\\": [\\n    {\\\"title\\\": \\\"Titulo clausula\\\", \\\"content\\\": \\\"Contenido relevante\\\"}\\n  ]\\n}\\n\\nResponde SOLO con el JSON, sin texto adicional.\" }, { role: 'user', content: 'Analiza este contrato:\n\n' + ($json.text || '').slice(0, 60000) } ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "analyze-with-gpt",
      "name": "Analizar con GPT-4o-mini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "openaiCredencial",
          "name": "OpenAI"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend-info:8000/webhooks/n8n/analysis-complete",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ secret: $env.N8N_WEBHOOK_SECRET, contract_id: $('Webhook - Recibir Contrato').item.json.body.contrato_id, user_id: $('Webhook - Recibir Contrato').item.json.body.usuario_id, status: 'completado', summary: JSON.parse($json.choices[0].message.content).summary, parties: JSON.parse($json.choices[0].message.content).parties || [], key_dates: JSON.parse($json.choices[0].message.content).key_dates || [], risks: JSON.parse($json.choices[0].message.content).risks || [], clauses: JSON.parse($json.choices[0].message.content).clauses || [], raw_text: $('Extraer Texto PDF').item.json.text || '' }) }}",
        "options": {}
      },
      "id": "notify-backend",
      "name": "Notificar Backend - Exito",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1230,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend-info:8000/webhooks/n8n/analysis-complete",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ secret: $env.N8N_WEBHOOK_SECRET, contract_id: $('Webhook - Recibir Contrato').item.json.body.contrato_id, status: 'error', error_message: 'Secret invalido' }) }}",
        "options": {}
      },
      "id": "notify-backend-error",
      "name": "Notificar Backend - Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend-info:8000/webhooks/n8n/analysis-complete",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ secret: $env.N8N_WEBHOOK_SECRET, contract_id: $('Webhook - Recibir Contrato').item.json.body.contrato_id, status: 'error', error_message: ($json.error && $json.error.message) || 'Error en el análisis' }) }}",
        "options": {}
      },
      "id": "notify-backend-failure",
      "name": "Notificar Backend - Falla",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        420
      ]
    }
  ],
  "connections": {
    "Webhook - Recibir Contrato": {
      "main": [
        [
          {
            "node": "Validar Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Secret": {
      "main": [
        [
          {
            "node": "Descargar PDF de Azure",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Backend - Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar PDF de Azure": {
      "main": [
        [
          {
            "node": "Extraer Texto PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Backend - Falla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer Texto PDF": {
      "main": [
        [
          {
            "node": "Analizar con GPT-4o-mini",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Backend - Falla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analizar con GPT-4o-mini": {
      "main": [
        [
          {
            "node": "Notificar Backend - Exito",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notificar Backend - Falla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}