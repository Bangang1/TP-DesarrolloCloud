# Copiar como .env.local y completar los valores.
# Las variables NEXT_PUBLIC_* quedan visibles en el navegador: no poner secretos ahí.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Azure Blob Storage (solo se usan en el servidor, para generar URLs SAS de subida).
# Mismos valores que en backend-info/.env
AZURE_STORAGE_ACCOUNT_NAME=tu-cuenta
AZURE_STORAGE_ACCOUNT_KEY=tu-account-key
AZURE_STORAGE_CONTAINER_NAME=contratos
